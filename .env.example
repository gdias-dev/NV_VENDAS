APP_NAME="Nova Varonil"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://novavaronillab.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# ---- Banco de dados -------------------------------------------------------
# Para testar no seu computador (mais simples, não precisa instalar MySQL):
DB_CONNECTION=sqlite
# O arquivo já vem criado em database/database.sqlite

# Na KingHost, troque as linhas acima por estas (dados do painel da KingHost):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=novavaronil
# DB_USERNAME=root
# DB_PASSWORD=

# Usados só uma vez, ao rodar "php artisan db:seed", para criar o admin inicial.
# Troque a senha por uma sua antes de rodar o seed, e troque de novo depois do primeiro login.
ADMIN_SEED_EMAIL=admin@novavaronillab.com.br
ADMIN_SEED_SENHA=trocar123

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- E-mail (formulário de contato) -------------------------------------
# Em desenvolvimento use "log" (grava o e-mail em storage/logs).
# Na KingHost use "smtp" com os dados de uma conta de e-mail do domínio.
#   Porta 465 -> MAIL_SCHEME=smtps    |    Porta 587 -> MAIL_SCHEME=smtp
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="site@novavaronillab.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Dados de contato exibidos no site ----------------------------------
NOVA_EMAIL_CONTATO=
NOVA_TELEFONE=
NOVA_WHATSAPP=
NOVA_ENDERECO="Centro, Rio de Janeiro - RJ"
NOVA_HORARIO="Segunda a sexta, em horário comercial"
NOVA_INSTAGRAM="https://www.instagram.com/novavaronil"
NOVA_MAPA_URL=
